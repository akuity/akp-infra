.terraform/
*.tfstate
*.tfstate.*

# Variable files may contain org-specific values; only the examples are committed.
*.tfvars
!*.tfvars.example

# Cluster credentials
.kubeconfigs/

# Git worktrees used for isolated feature work
.worktrees/
